{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IRIXEN Code",
  "version": "0.4.0-beta.1",
  "identifier": "com.irixen.code",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "IRIXEN Code",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 940,
        "minHeight": 560,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true,
        "visible": true,
        "center": true,
        "theme": "Light",
        "backgroundColor": "#eaedf2"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**", "$APPDATA/**", "$CONFIG/**", "$RESOURCE/**", "$CACHE/**", "$TEMP/**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "IRIXEN",
    "copyright": "© 2026 IRIXEN",
    "category": "DeveloperTool",
    "shortDescription": "IRIXEN Code — lightweight desktop IDE with built-in IRIXEN Agent",
    "longDescription": "IRIXEN Code is a small, fast desktop IDE with the IRIXEN Agent built in. It speaks OpenAI / Anthropic / Gemini compatible protocols, auto-discovers models and reasoning effort, compresses context aggressively, supports MCP tools and installable skills, and stays light on memory and disk.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libssl3"
        ]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "installerHooks": "installer.nsh"
      }
    }
  }
}
